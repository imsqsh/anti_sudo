# WhatsApp recipient in E.164 format (must be in OpenClaw's channels.whatsapp.allowFrom)
WHATSAPP_TARGET=+15555550123

# Where runtime state lives (SQLite DB, browser profile, logs). Keep outside the repo.
DATA_DIR=~/openclaw-instagram-jobs

# true = do everything except actually send WhatsApp messages
DRY_RUN=true

# "chrome" = your installed Google Chrome; empty = Playwright's bundled Chromium (Linux/Docker)
BROWSER_CHANNEL=chrome

# Timezone for log timestamps (Docker defaults to UTC)
TZ=America/New_York
